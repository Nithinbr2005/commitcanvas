# Environment variables for CommitCanvas backend
# Copy to .env and fill values before running

PORT=4000
# Optional: ANTHROPIC_API_KEY for narration
ANTHROPIC_API_KEY=
# Optional: GitHub token to increase rate limits and fetch private repos if authorized
GITHUB_TOKEN=
# Optional: Redis connection URL if you want Redis caching (not required for scaffold)
REDIS_URL=
# Path to ffmpeg binary if not on PATH
FFMPEG_PATH=
